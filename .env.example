APP_NAME=AI Love Strategist
APP_ENV=development
APP_DEBUG=true

HOST=127.0.0.1
PORT=18080

DATABASE_PATH=/opt/ai-love-strategist/data/app.sqlite3
LOG_DIR=/opt/ai-love-strategist/logs
LOG_LEVEL=INFO

# TEST-150 offsite disaster-recovery sink. The directory must already be mounted
# on storage distinct from the local SQLite/managed-backup device. The app does
# not create or authenticate the remote mount itself.
OFFSITE_BACKUP_DIRECTORY=
# Generate with: python -m app.offsite_backup --generate-key
# Escrow this key outside the application server; losing it makes encrypted
# offsite bundles unrecoverable.
OFFSITE_BACKUP_ENCRYPTION_KEY=
OFFSITE_BACKUP_KEEP=30

LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# Transitional TEST-114 bootstrap credential. Disabled by default now that
# account login issues DB-backed sessions. Enable only for an explicit migration
# or emergency compatibility window, then disable it again.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BEARER_TOKEN=

# Required when user-managed LLM API keys are persisted.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CONFIG_ENCRYPTION_KEY=
