APP_NAME=AI Love Strategist
APP_ENV=development
APP_DEBUG=true

HOST=127.0.0.1
PORT=18080

DATABASE_PATH=/opt/ai-love-strategist/data/app.sqlite3
LOG_DIR=/opt/ai-love-strategist/logs
LOG_LEVEL=INFO

LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# Required when APP_ENV=production. Use a high-entropy random value and keep it secret.
AUTH_BEARER_TOKEN=

# Required when user-managed LLM API keys are persisted.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CONFIG_ENCRYPTION_KEY=
