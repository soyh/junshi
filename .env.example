# For fresh local installs use: python scripts/init_local.py
# The paths below are Linux server examples; do not copy unchanged on Windows.
APP_NAME=AI Love Strategist
APP_ENV=development
APP_DEBUG=true

HOST=127.0.0.1
PORT=18080

DATABASE_PATH=/opt/ai-love-strategist/data/app.sqlite3
MEDIA_STORAGE_DIRECTORY=/opt/ai-love-strategist/data/media
LOG_DIR=/opt/ai-love-strategist/logs
LOG_LEVEL=INFO

# TEST-150 portable recovery. The server creates encrypted recovery bundles here;
# a trusted local Windows computer pulls them over SSH/SCP and keeps the durable
# copy outside the server. Generate once with:
# python -m app.portable_backup --generate-key
# The production .env is itself backed up to Windows using DPAPI so this key can
# be recovered when the server is replaced. Never commit a real key to GitHub.
PORTABLE_BACKUP_DIRECTORY=/opt/ai-love-strategist/data/recovery_exports
PORTABLE_BACKUP_ENCRYPTION_KEY=
PORTABLE_BACKUP_KEEP=7

LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# Transitional TEST-114 bootstrap credential. Disabled by default now that
# account login issues DB-backed sessions. Enable only for an explicit migration
# or emergency compatibility window, then disable it again.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BEARER_TOKEN=

# Required when user-managed LLM API keys are persisted.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_CONFIG_ENCRYPTION_KEY=

# TEST-228 email verification: configure on the server, never commit credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_IMPLICIT_TLS=true
EMAIL_VERIFICATION_SECRET=
# Set true after SMTP verification and all clients are updated.
EMAIL_REGISTRATION_REQUIRED=false
